# Logto (Traditional Web)
LOGTO_ISSUER=https://auth.deepacquire.com/oidc
LOGTO_JWKS_URI=https://auth.deepacquire.com/oidc/jwks
LOGTO_APP_ID=6p53kcej5oe9skvwfh6yp
LOGTO_APP_SECRET=
LOGTO_SCOPES=openid profile email offline_access

# Gateway worker (consumed by /pricing and /checkout/[plan])
# Plans metadata is fetched from `${GATEWAY_API_URL}/api/plans` at SSR time
# with a 5s timeout and a built-in fallback in src/utils/plans.ts.
GATEWAY_API_URL=https://api.deepacquire.com

# SSO bridge (consumed by /auth/sso, see docs/sso-bridge.md)
# Shared secret sent in `X-Site-Secret` when calling gateway-worker
# `/api/auth/redeem-handoff`. MUST match the worker's SITE_REDEEM_SECRET.
SITE_REDEEM_SECRET=

# HMAC secret used by gateway-worker to sign HS256 site session JWTs.
# Used here to verify cookies locally. MUST match the worker's GATEWAY_SHARED_SECRET.
GATEWAY_SHARED_SECRET=

