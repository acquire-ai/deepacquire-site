---
import Headline from '~/components/ui/Headline.astro';
import { formatBytes, type DownloadFile } from '~/utils/downloads';

export interface Props {
  title: string;
  subtitle: string;
  emptyMessage: string;
  downloadLabel: string;
  dateLocale: string;
  files: DownloadFile[];
  errorMessage: string;
}

const { title, subtitle, emptyMessage, downloadLabel, dateLocale, files, errorMessage } = Astro.props;
---

<section class="px-4 py-16 sm:px-6 mx-auto lg:px-8 lg:py-20 max-w-4xl">
  <Headline title={title} subtitle={subtitle} />

  {errorMessage && <div class="bg-red-100 text-red-800 p-4 rounded-lg mb-8 text-center">{errorMessage}</div>}

  {
    !errorMessage && files.length === 0 && (
      <div class="text-center text-gray-500 dark:text-gray-400 py-12">{emptyMessage}</div>
    )
  }

  {
    !errorMessage && files.length > 0 && (
      <div class="bg-white dark:bg-slate-900 shadow-md rounded-lg overflow-hidden">
        <ul class="divide-y divide-gray-200 dark:divide-gray-700">
          {files.map((file) => (
            <li class="p-4 sm:px-6 flex items-center justify-between hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors">
              <div class="flex flex-col">
                <span class="text-lg font-medium text-gray-900 dark:text-white truncate max-w-[200px] sm:max-w-md">
                  {file.name}
                </span>
                <span class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                  {file.date.toLocaleDateString(dateLocale)} • {formatBytes(file.size)}
                </span>
              </div>
              <a
                href={file.url}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-4 inline-flex items-center justify-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
              >
                {downloadLabel}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>
