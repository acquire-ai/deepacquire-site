---
import { Icon } from 'astro-icon/components';
import { getBlogPermalink } from '~/utils/permalinks';
import { I18N } from 'astrowind:config';
import { localizePath, defaultLocale } from '~/i18n/utils';
import Button from '~/components/ui/Button.astro';

const { textDirection } = I18N;
const currentLocale = Astro.currentLocale || defaultLocale;
const label = currentLocale === 'zh-CN' ? '返回博客' : currentLocale === 'zh-TW' ? '返回部落格' : 'Back to Blog';
---

<div class="mx-auto px-6 sm:px-6 max-w-3xl pt-8 md:pt-4 pb-12 md:pb-20">
  <Button variant="tertiary" class="px-3 md:px-3" href={localizePath(getBlogPermalink(), currentLocale)}>
    {
      textDirection === 'rtl' ? (
        <Icon name="tabler:chevron-right" class="w-5 h-5 mr-1 -ml-1.5 rtl:-mr-1.5 rtl:ml-1" />
      ) : (
        <Icon name="tabler:chevron-left" class="w-5 h-5 mr-1 -ml-1.5 rtl:-mr-1.5 rtl:ml-1" />
      )
    }
    {label}
  </Button>
</div>
