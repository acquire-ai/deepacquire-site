---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pricing',
  description:
    'Choose the perfect DeepAcquire plan for your language learning journey. Free, Pro, and Prime plans available.',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Simple, Transparent Pricing"
    subtitle="Start learning languages for free. Upgrade when you need more."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Choose your plan"
    subtitle="All plans include core features. Upgrade for higher limits and premium capabilities."
    prices={[
      {
        title: 'Free',
        subtitle: 'Get started at no cost',
        price: '0',
        period: 'forever',
        items: [
          { description: 'Custom AI Provider' },
          { description: 'Advanced Word Analysis' },
          { description: 'Vocabulary Sync' },
          { description: 'Subtitle Enhance (60h/mo)' },
          { description: 'AI Translation (900 min/mo)' },
          { description: 'ASR Transcription (1h one-time)' },
        ],
        callToAction: {
          text: 'Get Started',
          href: 'https://chrome.google.com/webstore/detail/pnobdlbfobamledoecdignpneeoohhio',
          target: '_blank',
        },
      },
      {
        title: 'Pro',
        subtitle: 'For regular learners',
        price: 3,
        period: 'per month',
        items: [
          { description: 'Custom AI Provider' },
          { description: 'Advanced Word Analysis' },
          { description: 'Vocabulary Sync' },
          { description: 'Subtitle Enhance (Unlimited)' },
          { description: 'AI Translation (2,700 min/mo)' },
          { description: 'ASR Transcription (5h/mo)' },
        ],
        callToAction: {
          text: 'Subscribe',
          href: '/checkout/pro',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'Prime',
        subtitle: 'For power users',
        price: 19.9,
        period: 'per month',
        items: [
          { description: 'Custom AI Provider' },
          { description: 'Advanced Word Analysis' },
          { description: 'Vocabulary Sync' },
          { description: 'Subtitle Enhance (Unlimited)' },
          { description: 'AI Translation (Unlimited)' },
          { description: 'ASR Transcription (15h/mo)' },
        ],
        callToAction: {
          text: 'Subscribe',
          href: '/checkout/prime',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Why choose DeepAcquire?"
    subtitle="Powerful features designed for real language acquisition"
    columns={2}
    items={[
      {
        title: 'AI-Powered Subtitles',
        description:
          'Get real-time AI translations and enhanced subtitles while watching YouTube videos in any language.',
        icon: 'tabler:language',
      },
      {
        title: 'Bring Your Own AI',
        description:
          'Use your own AI provider (OpenAI, Gemini, etc.) for free — no vendor lock-in, full control over costs.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'One-Click Vocabulary',
        description:
          'Click any word to see definitions, examples, and context. Save words to your personal vocabulary notebook.',
        icon: 'tabler:vocabulary',
      },
      {
        title: 'Cross-Device Sync',
        description: 'Your vocabulary and learning progress sync across all your devices seamlessly.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Secure Payments',
        description: 'All payments are processed securely through Stripe. Cancel anytime with no hidden fees.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Flexible Plans',
        description: 'Start free and upgrade when ready. Downgrade or cancel anytime — your data is always yours.',
        icon: 'tabler:arrows-exchange',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Get started in minutes"
    tagline="How it works"
    isReversed={true}
    items={[
      {
        title: 'Install the extension',
        description: 'Add DeepAcquire to Chrome or Edge from the Web Store.',
        icon: 'tabler:number-1',
      },
      {
        title: 'Sign up for free',
        description: 'Create your account to unlock all free-tier features.',
        icon: 'tabler:number-2',
      },
      {
        title: 'Choose a plan',
        description: 'Pick the plan that fits your learning goals and budget.',
        icon: 'tabler:number-3',
      },
      {
        title: 'Start learning',
        description: 'Watch YouTube videos with AI-powered subtitles and build your vocabulary.',
        icon: 'tabler:number-4',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about DeepAcquire plans and billing."
    columns={1}
    items={[
      {
        title: 'What can I do with the Free plan?',
        description:
          "The Free plan includes all core features: custom AI provider support, advanced word analysis, vocabulary sync, subtitle enhancement (60h/mo), AI translation (900 min/mo), and a one-time ASR transcription trial (1h). It's enough to experience the full power of DeepAcquire.",
      },
      {
        title: 'Can I use my own AI provider for free?',
        description:
          'Yes! All plans — including Free — support bringing your own AI provider (OpenAI, Gemini, Groq, etc.). You only pay your provider directly, and DeepAcquire charges nothing extra for this feature.',
      },
      {
        title: 'How does billing work?',
        description:
          'Subscriptions are billed monthly through Stripe. You can upgrade, downgrade, or cancel at any time. When you cancel, your plan remains active until the end of the current billing period.',
      },
      {
        title: 'Can I switch between plans?',
        description:
          'Absolutely. You can upgrade or downgrade at any time. Changes take effect immediately, and billing is prorated automatically.',
      },
      {
        title: 'What payment methods are accepted?',
        description:
          'We accept all major credit and debit cards (Visa, Mastercard, American Express) as well as various local payment methods through Stripe.',
      },
      {
        title: 'Will my subscription work across devices?',
        description:
          'Yes. Your subscription is tied to your DeepAcquire account, not a specific device. Sign in on any browser with the extension installed and your plan benefits apply automatically.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Ready to learn languages effortlessly?"
    subtitle="Install DeepAcquire and start watching YouTube in any language today."
    actions={[
      {
        variant: 'primary',
        text: 'Install Free Extension',
        href: 'https://chrome.google.com/webstore/detail/pnobdlbfobamledoecdignpneeoohhio',
        target: '_blank',
      },
    ]}
  />
</Layout>
