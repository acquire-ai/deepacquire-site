---
export const prerender = false;

import ConfirmDialog from '~/components/ui/ConfirmDialog.astro';
import Layout from '~/layouts/PageLayout.astro';
import { parseCookies } from '~/utils/auth/cookies';
import { getEnvValue, getSessionVerifierConfig, verifySession, LOGTO_COOKIES } from '~/utils/auth/logto';
import { PLAN_CONTENT } from '~/data/plan-features';
import type { PlanId } from '~/utils/plans';

const metadata = {
  title: 'Account',
};

const cookies = parseCookies(Astro.request.headers.get('cookie'));
const sessionToken = cookies[LOGTO_COOKIES.idToken];

if (!sessionToken) {
  return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

Astro.response.headers.set('Cache-Control', 'private, no-store');

let claims: Awaited<ReturnType<typeof verifySession>>;
try {
  claims = await verifySession(sessionToken, getSessionVerifierConfig(Astro.locals));
} catch {
  return Astro.redirect(`/auth/sign-in?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
}

const email = (claims.email as string | undefined) ?? undefined;
const name =
  (claims.name as string | undefined) ??
  (claims.preferred_username as string | undefined) ??
  (claims.nickname as string | undefined) ??
  undefined;
const displayName = name ?? email ?? (claims.sub as string);
const avatarUrl = (claims.picture as string | undefined) ?? undefined;

const avatarInitial = displayName?.trim()?.[0]?.toUpperCase() ?? '?';

// --- Subscription status (best-effort, degrade to "Free" on any failure) ---
type SubscriptionStatus = {
  plan: string;
  status: string;
  currentPeriodEnd: number | null;
  cancelAtPeriodEnd: boolean;
};

const KNOWN_PLAN_IDS: ReadonlySet<PlanId> = new Set<PlanId>(['free', 'plus', 'pro', 'max']);
const SUB_FETCH_TIMEOUT_MS = 5000;

let subscription: SubscriptionStatus | null = null;
const gatewayUrl = getEnvValue('GATEWAY_API_URL', Astro.locals);
if (gatewayUrl) {
  try {
    const res = await fetch(`${gatewayUrl.replace(/\/+$/g, '')}/api/subscription/status`, {
      headers: { Authorization: `Bearer ${sessionToken}` },
      signal: AbortSignal.timeout(SUB_FETCH_TIMEOUT_MS),
    });
    if (res.ok) {
      const body = (await res.json()) as Partial<SubscriptionStatus>;
      if (typeof body.plan === 'string' && typeof body.status === 'string') {
        subscription = {
          plan: body.plan,
          status: body.status,
          currentPeriodEnd: typeof body.currentPeriodEnd === 'number' ? body.currentPeriodEnd : null,
          cancelAtPeriodEnd: Boolean(body.cancelAtPeriodEnd),
        };
      }
    } else {
      console.warn(`[account] /api/subscription/status returned ${res.status}`);
    }
  } catch (err) {
    console.warn('[account] failed to fetch subscription status:', err);
  }
}

const planId: PlanId =
  subscription && KNOWN_PLAN_IDS.has(subscription.plan as PlanId) ? (subscription.plan as PlanId) : 'free';
const planDisplayName = PLAN_CONTENT.en[planId].displayName;
const isPaid = planId !== 'free';
const subStatus = subscription?.status ?? 'active';
const cancelAtPeriodEnd = subscription?.cancelAtPeriodEnd ?? false;
const periodEndDate =
  subscription?.currentPeriodEnd && Number.isFinite(subscription.currentPeriodEnd)
    ? new Date(subscription.currentPeriodEnd * 1000)
    : null;
const periodEndLabel = periodEndDate
  ? periodEndDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;

const statusBadge: { label: string; classes: string } = (() => {
  if (cancelAtPeriodEnd)
    return { label: 'Canceling', classes: 'bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-200' };
  if (subStatus === 'active' || subStatus === 'trialing') {
    return { label: 'Active', classes: 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-200' };
  }
  if (subStatus === 'past_due' || subStatus === 'unpaid') {
    return { label: 'Payment issue', classes: 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-200' };
  }
  if (subStatus === 'canceled') {
    return { label: 'Canceled', classes: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300' };
  }
  return { label: subStatus, classes: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300' };
})();

// `?subscription_change=has_active` is set when the /checkout/[plan] route
// detected a stacked-subscription attempt (409 from the gateway). We show a
// confirm dialog so they explicitly opt-in to leaving for Stripe's portal.
const showSubChangeDialog = Astro.url.searchParams.get('subscription_change') === 'has_active';
---

<Layout metadata={metadata}>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight text-default">Account</h1>

    <div class="mt-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6">
      <div class="flex items-center gap-4">
        {
          avatarUrl ? (
            <img
              src={avatarUrl}
              alt="Avatar"
              class="h-12 w-12 rounded-full border border-gray-200 dark:border-gray-700 object-cover"
              loading="lazy"
              referrerpolicy="no-referrer"
            />
          ) : (
            <div class="h-12 w-12 rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 flex items-center justify-center font-semibold text-default">
              {avatarInitial}
            </div>
          )
        }
        <div>
          <div class="text-sm text-muted">Signed in as</div>
          <div class="mt-0.5 text-lg font-semibold text-default">{displayName}</div>
          {email && <div class="text-sm text-muted">{email}</div>}
        </div>
      </div>

      <details class="mt-6">
        <summary class="cursor-pointer select-none text-sm text-muted hover:text-default">Advanced</summary>
        <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">User ID (sub)</dt>
            <dd class="mt-1 break-all text-sm text-default">{claims.sub as string}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Name</dt>
            <dd class="mt-1 break-all text-sm text-default">{name ?? '-'}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-muted">Email</dt>
            <dd class="mt-1 break-all text-sm text-default">{email ?? '-'}</dd>
          </div>
        </dl>
      </details>

      <div class="mt-8 flex gap-3">
        <a class="btn-secondary" href="/auth/sign-out" data-astro-reload data-astro-prefetch="false">Sign out</a>
      </div>
    </div>

    <div class="mt-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <div class="text-sm text-muted">Subscription</div>
          <div class="mt-1 flex items-center gap-2">
            <span class="text-lg font-semibold text-default">{planDisplayName}</span>
            {
              isPaid && (
                <span
                  class={`inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ${statusBadge.classes}`}
                >
                  {statusBadge.label}
                </span>
              )
            }
          </div>
          {
            isPaid && periodEndLabel && (
              <div class="mt-1 text-sm text-muted">
                {cancelAtPeriodEnd ? `Ends on ${periodEndLabel}` : `Renews on ${periodEndLabel}`}
              </div>
            )
          }
          {!isPaid && <div class="mt-1 text-sm text-muted">You're on the Free plan.</div>}
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          isPaid ? (
            <>
              <a class="btn-primary" href="/account/billing-portal" data-astro-prefetch="false">
                Manage subscription
              </a>
              <a class="btn-secondary" href="/pricing" data-astro-prefetch="false">
                Compare plans
              </a>
            </>
          ) : (
            <a class="btn-primary" href="/pricing" data-astro-prefetch="false">
              Upgrade plan
            </a>
          )
        }
      </div>

      {
        isPaid && (
          <p class="mt-4 text-xs text-muted">
            Cancel, switch plan, or update your payment details through the Stripe customer portal. Changes sync back
            automatically.
          </p>
        )
      }
    </div>
  </div>

  {
    showSubChangeDialog && (
      <ConfirmDialog
        id="subscription-change-dialog"
        title="You already have an active subscription"
        description="To switch plans, cancel, or update your payment details, you'll be taken to the Stripe portal."
        confirmLabel="Manage subscription"
        cancelLabel="Stay on account"
        confirmHref="/account/billing-portal"
        dismissUrl="/account"
        open
      />
    )
  }
</Layout>
