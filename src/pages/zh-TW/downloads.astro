---
import Layout from '~/layouts/PageLayout.astro';
import DownloadsSection from '~/components/downloads/DownloadsSection.astro';
import { fetchDownloadFiles } from '~/utils/downloads';

export const prerender = false;

const metadata = {
  title: '下載',
};

const { files, errorMessage } = await fetchDownloadFiles(Astro.locals);
---

<Layout metadata={metadata}>
  <DownloadsSection
    title="下載"
    subtitle="下載 DeepAcquire 最新 zip 安裝包（適用於無法存取應用商店的用戶）。"
    emptyMessage="暫無可用安裝包。"
    downloadLabel="下載"
    dateLocale="zh-TW"
    files={files}
    errorMessage={errorMessage}
  />
</Layout>
