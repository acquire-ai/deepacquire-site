---
import Layout from '~/layouts/PageLayout.astro';
import DownloadsSection from '~/components/downloads/DownloadsSection.astro';
import { fetchDownloadFiles } from '~/utils/downloads';

export const prerender = false;

const metadata = {
  title: '下载',
};

const { files, errorMessage } = await fetchDownloadFiles(Astro.locals);
---

<Layout metadata={metadata}>
  <DownloadsSection
    title="下载"
    subtitle="下载 DeepAcquire 最新 zip 安装包（适用于无法访问应用商店的用户）。"
    emptyMessage="暂无可用安装包。"
    downloadLabel="下载"
    dateLocale="zh-CN"
    files={files}
    errorMessage={errorMessage}
  />
</Layout>
